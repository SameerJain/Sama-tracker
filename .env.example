# required
DISCORD_TOKEN=
STARTGG_TOKEN=
# single-server builds (the default) post in one server and channel
GUILD_ID=
CHANNEL_ID=
# opt in to multi-server: serve every server the bot is invited to, each with its
# own track list, settings and /setup posts channel. leave GUILD_ID and CHANNEL_ID
# out with this on; a set GUILD_ID migrates into that server's entry on first boot
#MULTI_GUILD=true

# optional. Smash fun commands write more with the Claude one; the YouTube one adds
# video context to those posts
ANTHROPIC_API_KEY=
YOUTUBE_API_KEY=

# optional. where state.json lives. default is data/ next to the code,
# or Railway's volume path when one is attached
#STATE_DIR=/srv/sama-tracker/data
